#!/usr/bin/env bash
set -euo pipefail

# --- Backend (PHP) ---
PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' || true)
if [ -n "$PHP_FILES" ]; then
  echo "[pre-commit] Pint fix..."
  BACKEND_FILES=$(echo "$PHP_FILES" | sed 's|backend/||g')
  docker compose exec -T backend ./vendor/bin/pint $BACKEND_FILES
  docker compose exec -T backend ./vendor/bin/phpcbf --standard=phpcs.xml $BACKEND_FILES || true
  git add $PHP_FILES
fi

# --- Frontend (JS/TS) ---
JS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx)$' || true)
if [ -n "$JS_FILES" ]; then
  echo "[pre-commit] ESLint --fix..."
  FRONTEND_FILES=$(echo $JS_FILES | sed 's|frontend/||g')
  docker compose exec -T frontend npx eslint --fix $FRONTEND_FILES
  git add $JS_FILES
fi
